# PostgreSQL connection — replace USER/PASSWORD with what you set during install
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/chatapp?schema=public"

# JWT secrets — replace these with long random strings in your real .env
# (never commit the real .env file to git)
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_REFRESH_EXPIRES_IN="30d"

# Server
PORT=4000
FRONTEND_URL="http://localhost:3000"

# File storage — local disk for development.
# Uploaded files are written to backend/uploads and served at /uploads/*
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=25
